# Template for .env - copy to .env and fill in real values.
# Only one MODEL line may be active: lines starting with # are ignored.

# --- LLM: AWS Bedrock (disabled, kept for later use) ---
# Requires boto3 (see pyproject.toml) and AWS credentials.
# MODEL=bedrock/apac.amazon.nova-pro-v1:0
# AWS_DEFAULT_REGION=ap-southeast-2

# --- LLM: local Ollama in Docker (active) ---
# Format is <provider>/<model>. The model must be pulled first:
#   docker compose exec ollama ollama pull llama3.2:3b
MODEL=ollama/llama3.2:3b
# Address of the Ollama server (port published by docker-compose.yml).
OLLAMA_API_BASE=http://localhost:11434

# --- Tools ---
# Web search used by the vacation_researcher agent (https://serper.dev).
Serper_API_KEY=your-serper-api-key
