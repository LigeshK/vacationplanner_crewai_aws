# Template for .env - copy to .env and fill in real values.
# Only one MODEL line may be active: lines starting with # are ignored.

# --- LLM: AWS Bedrock (disabled, kept for later use) ---
# Requires boto3 (see pyproject.toml) and AWS credentials.
# MODEL=bedrock/apac.amazon.nova-pro-v1:0
# AWS_DEFAULT_REGION=ap-southeast-2

# --- LLM: local Ollama in Docker (active) ---
# Format is <provider>/<model>. The model must be pulled first:
#   docker compose exec ollama ollama pull qwen2.5:0.5b
MODEL=ollama/qwen2.5:0.5b
# Address of the Ollama server (port published by docker-compose.yml).
OLLAMA_API_BASE=http://localhost:11434

# --- Tools ---
# Web search used by the vacation_researcher agent (https://serper.dev).
Serper_API_KEY=your-serper-api-key

# --- AWS ---
AWS_REGION=ap-southeast-2

# --- AgentCore Memory (crew.py) ---
AGENTCORE_MEMORY_ID=your-agentcore-memory-id

# --- AgentCore Gateway + Cognito auth (crew.py, src/GWTEST/gwtest.py) ---
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_TOKEN_URL=https://<domain>.auth.<region>.amazoncognito.com/oauth2/token
GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
GATEWAY_TOOL_NAME=target-travel-agent-tool__get_travel_packages
MCP_PROTOCOL_VERSION=2025-11-25

# --- Streamlit UI backend (streamlitui.py); leave empty to use another backend ---
API_GATEWAY_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod/vacation_planner

# --- Lambda functions (src/lambda/) ---
# Reference only: Lambda does not read .env. Set these as environment variables in the Lambda console.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account>:runtime/<runtime-id>
AGENT_RUNTIME_QUALIFIER=vacation_planner01
TRAVEL_PACKAGES_TABLE=travel_packages
